<section class="pd-ov section-{{ section.id }}-padding">
  <div class="page-width">

    <div class="pd-ov__header">
      <h2 class="pd-ov__title">{{ section.settings.title }}</h2>
      <p class="pd-ov__desc">{{ section.settings.description }}</p>
    </div>

    <div class="pd-ov__icons">
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <div class="pd-ov__icon-item" {{ block.shopify_attributes }}>
            <div class="pd-ov__icon-wrap">
              {% if block.settings.icon_image != blank %}
                <img src="{{ block.settings.icon_image | image_url: width: 80 }}" alt="{{ block.settings.label }}" loading="lazy" width="48" height="48">
              {% else %}
                <span class="pd-ov__icon-emoji">{{ block.settings.icon_emoji | default: '✦' }}</span>
              {% endif %}
            </div>
            <span class="pd-ov__icon-label">{{ block.settings.label }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="pd-ov__trust">
      {% assign trust_items = section.blocks | where: "type", "trust_item" %}
      {% for block in trust_items %}
        <div class="pd-ov__trust-item" {{ block.shopify_attributes }}>
          <span class="pd-ov__trust-icon">✓</span>
          <span>{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="pd-ov__cta">
        <a href="{{ section.settings.button_link | default: '#' }}" class="pd-ov__btn">{{ section.settings.button_label }}</a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .pd-ov { background: #fff; }
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  .pd-ov__header { text-align: center; max-width: 700px; margin: 0 auto 40px; }
  .pd-ov__title { font-size: clamp(20px, 3vw, 34px); font-weight: 800; color: #1a1a1a; margin: 0 0 14px; line-height: 1.25; }
  .pd-ov__desc { font-size: 15px; color: #555; line-height: 1.7; margin: 0; }
  .pd-ov__icons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 32px; }
  .pd-ov__icon-item { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; padding: 20px 12px; background: #f5f8f9; border-radius: 12px; }
  .pd-ov__icon-wrap { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; }
  .pd-ov__icon-wrap img { width: 100%; height: 100%; object-fit: contain; }
  .pd-ov__icon-emoji { font-size: 28px; }
  .pd-ov__icon-label { font-size: 13px; font-weight: 600; color: #333; line-height: 1.3; }
  .pd-ov__trust { display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: center; margin-bottom: 28px; }
  .pd-ov__trust-item { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #444; }
  .pd-ov__trust-icon { color: #5a8a7a; font-weight: 700; }
  .pd-ov__cta { text-align: center; }
  .pd-ov__btn { display: inline-block; padding: 15px 40px; background: #1a1a1a; color: #fff; border-radius: 8px; font-size: 15px; font-weight: 700; text-decoration: none; transition: background 0.2s; }
  .pd-ov__btn:hover { background: #333; }
  @media (max-width: 749px) { .pd-ov__icons { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 400px) { .pd-ov__icons { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "PD - Product Overview",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Clinic-level RF. Done at home in 15 minutes." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>The VEAUTY Dot uses true 3D fractional RF technology — the same used in professional clinics — to rebuild collagen from within and deliver visible, lasting results without surgery, downtime, or facial fat loss.</p>" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Add to cart" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 60 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Icon",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon Image" },
        { "type": "text", "id": "icon_emoji", "label": "Emoji (if no image)", "default": "✦" },
        { "type": "text", "id": "label", "label": "Label", "default": "Collagen Boost" }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free Shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PD - Product Overview",
      "blocks": [
        { "type": "benefit", "settings": { "icon_emoji": "🧬", "label": "288% Collagen Boost" } },
        { "type": "benefit", "settings": { "icon_emoji": "💰", "label": "1/10th the Cost of Clinics" } },
        { "type": "benefit", "settings": { "icon_emoji": "⬆️", "label": "Lifting & Tightening" } },
        { "type": "benefit", "settings": { "icon_emoji": "🚫", "label": "No Facial Fat Loss" } },
        { "type": "trust_item", "settings": { "text": "Free Shipping" } },
        { "type": "trust_item", "settings": { "text": "Duties Paid" } },
        { "type": "trust_item", "settings": { "text": "24/7 Support" } }
      ]
    }
  ]
}
{% endschema %}
