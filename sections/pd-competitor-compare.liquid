<section class="pd-comp section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="pd-comp__header">
      {% if section.settings.badge != blank %}
        <span class="pd-comp__badge">{{ section.settings.badge }}</span>
      {% endif %}
      <h2 class="pd-comp__title">{{ section.settings.title }}</h2>
      <p class="pd-comp__sub">{{ section.settings.subtitle }}</p>
    </div>

    {% assign tab_blocks = section.blocks | where: "type", "tab" %}
    {% if tab_blocks.size > 0 %}
      <div class="pd-comp__tabs">
        {% for block in tab_blocks %}
          <button class="pd-comp__tab {% if forloop.first %}is-active{% endif %}"
                  data-tab-id="{{ block.id }}" {{ block.shopify_attributes }}>
            {{ block.settings.label }}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    {% for tab_block in tab_blocks %}
      <div class="pd-comp__panel {% if forloop.first %}is-active{% endif %}" data-panel="{{ tab_block.id }}">
        <div class="pd-comp__table-wrap">
          <div class="pd-comp__cols">

            <div class="pd-comp__col pd-comp__col--product">
              <div class="pd-comp__col-head">
                {% if section.settings.product_image != blank %}
                  <img src="{{ section.settings.product_image | image_url: width: 200 }}" alt="{{ section.settings.product_name }}" loading="lazy" width="120" height="180">
                {% endif %}
                <p class="pd-comp__col-price">{{ section.settings.product_price }}</p>
                <p class="pd-comp__col-name">{{ section.settings.product_name }}</p>
              </div>
              <div class="pd-comp__col-rows">
                {% assign feature_blocks = section.blocks | where: "type", "feature_row" %}
                {% for row in feature_blocks %}
                  <div class="pd-comp__row">
                    <span class="pd-comp__check-icon">✓</span>
                    <span class="pd-comp__row-text">{{ row.settings.product_value }}</span>
                  </div>
                {% endfor %}
              </div>
            </div>

            <div class="pd-comp__col pd-comp__col--competitor">
              <div class="pd-comp__col-head">
                {% if tab_block.settings.competitor_image != blank %}
                  <img src="{{ tab_block.settings.competitor_image | image_url: width: 200 }}" alt="{{ tab_block.settings.label }}" loading="lazy" width="120" height="180">
                {% else %}
                  <div class="pd-comp__comp-placeholder">{{ tab_block.settings.label }}</div>
                {% endif %}
                <p class="pd-comp__col-price">{{ tab_block.settings.competitor_price }}</p>
                <p class="pd-comp__col-name">{{ tab_block.settings.label }}</p>
              </div>
              <div class="pd-comp__col-rows">
                {% assign feature_blocks = section.blocks | where: "type", "feature_row" %}
                {% for row in feature_blocks %}
                  <div class="pd-comp__row pd-comp__row--bad">
                    <span class="pd-comp__x-icon">✕</span>
                    <span class="pd-comp__row-text">{{ row.settings.competitor_value }}</span>
                  </div>
                {% endfor %}
              </div>
            </div>

          </div>
        </div>
      </div>
    {% endfor %}

  </div>
</section>

<style>
  .pd-comp { background: #F5F2EE; }
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  .pd-comp__header { text-align: center; margin-bottom: 32px; }
  .pd-comp__badge { display: inline-block; border: 1px solid #aaa; border-radius: 100px; padding: 4px 14px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #666; margin-bottom: 12px; }
  .pd-comp__title { font-size: clamp(22px, 3.5vw, 42px); font-weight: 800; color: #1a1a1a; margin: 0 0 8px; }
  .pd-comp__title em { color: #C6A96B; font-style: normal; }
  .pd-comp__sub { font-size: 14px; color: #666; margin: 0; }
  .pd-comp__tabs { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-bottom: 32px; }
  .pd-comp__tab { padding: 9px 20px; border: 1.5px solid #ccc; border-radius: 100px; background: #fff; cursor: pointer; font-size: 14px; color: #555; transition: all 0.2s; }
  .pd-comp__tab.is-active { background: #C6A96B; color: #fff; border-color: #C6A96B; }
  .pd-comp__panel { display: none; }
  .pd-comp__panel.is-active { display: block; }
  .pd-comp__cols { display: grid; grid-template-columns: 1fr 1fr; max-width: 720px; margin: 0 auto; border-radius: 16px; overflow: hidden; border: 1px solid #E8D8D2; }
  .pd-comp__col { background: #fff; }
  .pd-comp__col--product { background: #F5F2EE; }
  .pd-comp__col-head { display: flex; flex-direction: column; align-items: center; padding: 24px 16px 20px; border-bottom: 1px solid #E8D8D2; min-height: 200px; }
  .pd-comp__col-head img { height: 120px; width: auto; object-fit: contain; margin-bottom: 12px; }
  .pd-comp__comp-placeholder { height: 120px; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #aaa; }
  .pd-comp__col-price { font-size: 13px; color: #888; margin: 0 0 4px; }
  .pd-comp__col-name { font-size: 14px; font-weight: 700; color: #1a1a1a; margin: 0; text-align: center; }
  .pd-comp__col-rows { padding: 0; }
  .pd-comp__row { display: flex; align-items: flex-start; gap: 10px; padding: 14px 16px; border-bottom: 1px solid #E8D8D2; font-size: 13px; color: #333; }
  .pd-comp__row:last-child { border-bottom: none; }
  .pd-comp__row--bad .pd-comp__row-text { color: #999; }
  .pd-comp__check-icon { flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%; background: #C6A96B; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; }
  .pd-comp__x-icon { flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%; background: #aaa; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; }
</style>

<script>
(function() {
  var section = document.currentScript.closest('.pd-comp') || document.querySelector('.pd-comp');
  if (!section) return;
  var tabs = section.querySelectorAll('.pd-comp__tab');
  var panels = section.querySelectorAll('.pd-comp__panel');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var id = tab.dataset.tabId;
      tabs.forEach(function(t) { t.classList.remove('is-active'); });
      panels.forEach(function(p) { p.classList.remove('is-active'); });
      tab.classList.add('is-active');
      var panel = section.querySelector('[data-panel="' + id + '"]');
      if (panel) panel.classList.add('is-active');
    });
  });
})();
</script>

{% schema %}
{
  "name": "PD - Competitor Compare",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "DEVICE VS" },
    { "type": "text", "id": "title", "label": "Heading", "default": "See How We Compare" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Safer & more effective than other home solutions" },
    { "type": "header", "content": "Your Product Column" },
    { "type": "image_picker", "id": "product_image", "label": "Product Image" },
    { "type": "text", "id": "product_name", "label": "Product Name", "default": "Celyra Device" },
    { "type": "text", "id": "product_price", "label": "Price Label", "default": "$$" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 60 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Competitor Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab Label / Competitor Name", "default": "Basic RF" },
        { "type": "image_picker", "id": "competitor_image", "label": "Competitor Product Image" },
        { "type": "text", "id": "competitor_price", "label": "Competitor Price Label", "default": "$$-$$$" }
      ]
    },
    {
      "type": "feature_row",
      "name": "Feature Row",
      "settings": [
        { "type": "text", "id": "product_value", "label": "Your Product Value", "default": "Precise, fractional technology" },
        { "type": "text", "id": "competitor_value", "label": "Competitor Value", "default": "Basic, uniform heating" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PD - Competitor Compare",
      "blocks": [
        { "type": "tab", "settings": { "label": "Basic RF", "competitor_price": "$$-$$$" } },
        { "type": "tab", "settings": { "label": "Red Light", "competitor_price": "$$" } },
        { "type": "tab", "settings": { "label": "Laser", "competitor_price": "$$$" } },
        { "type": "tab", "settings": { "label": "Cold Laser", "competitor_price": "$$$" } },
        { "type": "feature_row", "settings": { "product_value": "Precise, fractional technology", "competitor_value": "Basic, uniform heating" } },
        { "type": "feature_row", "settings": { "product_value": "Targets only up to the dermis layer", "competitor_value": "Uncontrolled depth. Causes facial fat loss" } },
        { "type": "feature_row", "settings": { "product_value": "Changeable fractional heads", "competitor_value": "Performance declines over time" } },
        { "type": "feature_row", "settings": { "product_value": "Even distribution of energy", "competitor_value": "Hot spots. Need to keep moving" } },
        { "type": "feature_row", "settings": { "product_value": "Used by professionals", "competitor_value": "No clinic adoption" } }
      ]
    }
  ]
}
{% endschema %}
