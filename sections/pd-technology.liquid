<section class="pd-tech section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="pd-tech__inner">

      <div class="pd-tech__left">
        {% if section.settings.badge != blank %}
          <span class="pd-tech__badge">{{ section.settings.badge }}</span>
        {% endif %}
        <h2 class="pd-tech__title">{{ section.settings.title }}</h2>
        <div class="pd-tech__desc">{{ section.settings.description }}</div>
      </div>

      <div class="pd-tech__right">
        {% if section.settings.diagram_image != blank %}
          <img src="{{ section.settings.diagram_image | image_url: width: 700 }}"
               alt="Technology Diagram" loading="lazy" width="700" height="420"
               class="pd-tech__diagram">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'pd-tech__placeholder' }}
        {% endif %}
      </div>

    </div>
  </div>
</section>

<style>
  .pd-tech { background: #f7fbfb; }
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  .pd-tech__inner { display: grid; grid-template-columns: 1fr 1.5fr; gap: 56px; align-items: center; border: 1px solid #d8eaea; border-radius: 20px; padding: 48px; background: #fff; }
  .pd-tech__badge { display: inline-block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #777; margin-bottom: 14px; }
  .pd-tech__title { font-size: clamp(22px, 3vw, 36px); font-weight: 700; color: #1a1a1a; margin: 0 0 20px; line-height: 1.3; }
  .pd-tech__title em { font-style: italic; color: #5a8a7a; }
  .pd-tech__desc { font-size: 15px; color: #555; line-height: 1.7; }
  .pd-tech__diagram { width: 100%; height: auto; border-radius: 10px; display: block; }
  .pd-tech__placeholder { width: 100%; aspect-ratio: 5/3; }
  @media (max-width: 899px) { .pd-tech__inner { grid-template-columns: 1fr; gap: 28px; padding: 28px; } }
</style>

{% schema %}
{
  "name": "PD - Technology",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "THE TECHNOLOGY" },
    { "type": "richtext", "id": "title", "label": "Heading", "default": "<p>No facial fat loss. <em>But how?</em></p>" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>It is only possible with true multi-polar fractional technology. Our device is calibrated to only send energy into the dermis — meaning more results with no unwanted side effects.</p>" },
    { "type": "image_picker", "id": "diagram_image", "label": "Technology Diagram Image" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 60 }
  ],
  "presets": [{ "name": "PD - Technology" }]
}
{% endschema %}
