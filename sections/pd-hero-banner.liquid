<section class="pd-hero section-{{ section.id }}-padding">
  <div class="pd-hero__inner {% if section.settings.full_width %}pd-hero__inner--full{% endif %}">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1600 }}"
           alt="{{ section.settings.heading | default: section.settings.image.alt }}"
           loading="lazy" width="1600" height="600"
           class="pd-hero__img">
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'pd-hero__img pd-hero__img--placeholder' }}
    {% endif %}

    {% if section.settings.heading != blank or section.settings.subtext != blank or section.settings.button_label != blank %}
      <div class="pd-hero__overlay" style="--overlay-opacity: {{ section.settings.overlay_opacity }}%;">
        <div class="pd-hero__content pd-hero__content--{{ section.settings.text_position }}">
          {% if section.settings.heading != blank %}
            <h2 class="pd-hero__heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subtext != blank %}
            <p class="pd-hero__subtext">{{ section.settings.subtext }}</p>
          {% endif %}
          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link | default: '#' }}" class="pd-hero__btn">{{ section.settings.button_label }}</a>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .pd-hero { background: #111; }
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  .pd-hero__inner { position: relative; overflow: hidden; border-radius: {{ section.settings.border_radius }}px; }
  .pd-hero__inner--full { border-radius: 0; }
  .pd-hero__img { width: 100%; height: {{ section.settings.height }}px; object-fit: cover; object-position: {{ section.settings.image_position }}; display: block; }
  .pd-hero__img--placeholder { display: block; width: 100%; height: {{ section.settings.height }}px; }
  .pd-hero__overlay { position: absolute; inset: 0; background: rgba(0,0,0,var(--overlay-opacity)); display: flex; align-items: center; }
  .pd-hero__content { padding: 40px; max-width: 600px; }
  .pd-hero__content--left { align-self: center; margin-right: auto; }
  .pd-hero__content--center { margin: 0 auto; text-align: center; }
  .pd-hero__content--right { margin-left: auto; text-align: right; }
  .pd-hero__heading { font-size: clamp(24px, 4vw, 52px); font-weight: 800; color: #fff; margin: 0 0 12px; line-height: 1.2; }
  .pd-hero__subtext { font-size: 16px; color: rgba(255,255,255,0.85); margin: 0 0 24px; line-height: 1.6; }
  .pd-hero__btn { display: inline-block; padding: 14px 32px; background: #fff; color: #1a1a1a; border-radius: 6px; text-decoration: none; font-size: 15px; font-weight: 700; transition: background 0.2s; }
  .pd-hero__btn:hover { background: #eee; }
  @media (max-width: 749px) {
    .pd-hero__img, .pd-hero__img--placeholder { height: {{ section.settings.mobile_height }}px; }
    .pd-hero__content { padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "PD - Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner Image" },
    { "type": "select", "id": "image_position", "label": "Image Position", "options": [{"value":"center center","label":"Center"},{"value":"top center","label":"Top"},{"value":"bottom center","label":"Bottom"},{"value":"center left","label":"Left"},{"value":"center right","label":"Right"}], "default": "center center" },
    { "type": "range", "id": "height", "min": 200, "max": 800, "step": 20, "unit": "px", "label": "Desktop Height", "default": 560 },
    { "type": "range", "id": "mobile_height", "min": 200, "max": 600, "step": 20, "unit": "px", "label": "Mobile Height", "default": 360 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width (no border radius)", "default": true },
    { "type": "range", "id": "border_radius", "min": 0, "max": 32, "step": 4, "unit": "px", "label": "Border Radius", "default": 0 },
    { "type": "header", "content": "Overlay & Text" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 70, "step": 5, "label": "Overlay Opacity %", "default": 0 },
    { "type": "select", "id": "text_position", "label": "Text Position", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding bottom", "default": 0 }
  ],
  "presets": [{ "name": "PD - Hero Banner" }]
}
{% endschema %}
